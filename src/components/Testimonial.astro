---
import { Image } from "astro:assets";
import HoverTilt from "./HoverTilt.astro";
const { name, image, quote } = Astro.props;
---

<HoverTilt rounded="0.5rem">
  <article>
    <Image class="image" src={image} alt={name} height={400} />
    <div>
      <h1>{name}</h1>
      <p>"{quote}"</p>
    </div>
  </article>
</HoverTilt>

<style>
  article {
    display: grid;
    align-items: space-between;
    box-shadow: 0 0 8px #0008;
    border-radius: 0.5rem;
    
  }
  .image {
    width: 100%;
    object-fit: cover;
    object-position: top;
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
  }
  article div {
    position: relative;
    margin-top: auto;
    padding: 0 1rem 1rem 1rem;
    background-color: #333;
    color: antiquewhite;
    border-bottom-left-radius: 0.5rem;
    border-bottom-right-radius: 0.5rem;

    &::before {
      --size: 24px;
      content: "";
      position: absolute;
      top: calc(-1 * var(--size));
      border-left: var(--size) solid transparent;
      border-right: var(--size) solid transparent;
      border-bottom: var(--size) solid #333;
    }
  }

  p {
    font-style: italic;
  }
</style>