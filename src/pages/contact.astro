  </main>
</Layout>

<style>
  .title {
    font-size: clamp(2em, 2em + 8vw, 8em);
    font-weight: 200;
  }

  main {
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    padding: 0.5rem 1rem;
  }

  .img-wrapper {
    display: grid;
    place-items: center;
    margin-top: 2rem;
  }

  .img {
    width: fit-content;
    max-width: 100%;
    object-fit: contain;
  }

  form {
    display: flex;
    flex-direction: column;
    
    gap: 1rem;
    width: 100%;
    max-width: 60ch;
    padding: 1rem;
    border: 1px solid #fff9;
    background-color: #6664;
    backdrop-filter: blur(2px);
    box-shadow: 0 0 8px #0008;
    border-radius: 0.5rem;

    h2 { text-align: center; }

    input, textarea {
      border-radius: 1rem;
      padding: 0.5rem 1rem;
      font-size: 1.2em;
    }

    textarea {
      resize: vertical;
    }
  }

  section {
    position: relative;
    display: grid;
    place-items: center;
    padding: 2rem;
    min-height: 50vh;
  }

  section .container {
    width: 100%;
    max-width: 80ch;
    display: grid;
    place-items: center;
    gap: 1rem;
  }

  section .backdrop {
	position: absolute;
	inset: 0;
	background-image: url('../assets/background.svg');
	background-repeat: no-repeat;
	background-size: cover;
	z-index: -1;
	filter: blur(8px);
}
</style>