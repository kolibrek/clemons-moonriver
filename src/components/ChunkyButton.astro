---
const { class: className, url } = Astro.props;
const Element = url ? 'a' : 'button';
---

<Element href={url} class:list={['btn-chunky', className]}>
  <slot/>
</Element>

<style>
  .btn-chunky {
    --color: oklch(0.6 0.2 260);
    --radius: 0.8em;
    
    &.red { --color: oklch(0.65 0.2 25); }
    &.green { --color: oklch(0.65 0.18 150); }
    &.orange { --color: oklch(0.7 0.18 60); }
    &.teal { --color: oklch(0.65 0.2 180); }
    &.purple { --color: oklch(0.6 0.2 300); }
    &.black { --color: oklch(0.2 0.01 260); }
    
    &.narrow { padding: 0.8em 1em; }
    &.small { font-size: 0.8em; }
    &.large { font-size: 1.2em; }

    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    top: -0.8em;
    margin-top: 1rem;
    color: white;
    font-size: 1em;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-wrap: balance;
    text-decoration: none;
    text-align: center;
    text-shadow: 0 -0.1em 0.1em oklch(0 0 0 / 0.2);
    background-color: var(--color);
    padding: 0.8em 2em;
    corner-shape: squircle;
    border-radius: var(--radius);
    border: 0.1em solid oklch(from var(--color) calc(l + 0.1) calc(c - 0.05) h);
    cursor: pointer;
    user-select: none;
    transition: top 0.2s ease, box-shadow 0.2s ease;
    box-shadow: inset 0 0 8px 8px #8880;

    &::after {
      content: "";
      display: block;
      position: absolute;
      inset: 0.8em -0.1em -0.8em;
      background: linear-gradient(
        to right,
        oklch(from var(--color) calc(l + 0.05) calc(c - 0.05) h) 0em,
        oklch(from var(--color) calc(l - 0.1) calc(c - 0.05) h) var(--radius),
        oklch(from var(--color) calc(l - 0.1) calc(c - 0.05) h) calc(100% - var(--radius)),
        oklch(from var(--color) calc(l + 0.05) calc(c - 0.05) h) 100%
      );
      /* opacity: 0.5; */
      border: 0.1em solid oklch(0 0 0 / 0.2);
      corner-shape: squircle;
      border-radius: var(--radius);
      z-index: -1;
      box-shadow: 0.1em 0.2em 0.4em
        oklch(from var(--color) calc(l - 0.3) c h / 0.3);
      transition: inset 0.2s ease, box-shadow 0.2s ease;
    }

    &:hover {
      box-shadow: inset 0px 0px 8px 8px #8881;
    }

    &:active {
      top: -0.3em;

      &::after {
        inset: 0.3em -0.1em -0.3em;
        box-shadow: 0em 0.1em 0.2em
          oklch(from var(--color) calc(l - 0.3) c h / 0.3);
      }
    }
  }
  
</style>