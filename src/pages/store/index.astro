---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const allProducts = await getCollection('products');
---
<Layout title="Store - Moonriver Instruments">
  <main>
    <Header>
      <h1 class="title">Store</h1>
    </Header>
    <section class="product-grid">
      <ul>
        {allProducts.map(product => (
          <li>
            <a href={`/store/${product.id}`}>
              <div class="img-wrapper">
                <Image class="product-image" src={product.data.cover} alt={product.id} layout='constrained' height="400"/>
              </div>
              <div>
                <h3>{product.data.title}</h3>
                <p>${product.data.cost}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .title {
    font-size: clamp(3em, 3em + 8vw, 8em);
    font-weight: 200;
  }
  .product-grid {
    display: grid;
    place-items: center;
    min-height: 80vh;
    width: 100%;
    max-width: 1300px;
    margin: 0 auto;
  }
  ul {
    list-style: none;
    display: grid;
    align-items: start;
    width: 100%;
  }
  li:nth-child(even) a {
    flex-direction: row-reverse;
    justify-content: end;
  }
  a {
    display: flex;
    align-items: start;
    justify-content: start;
    gap: 1rem;
    padding: 1rem;
    text-decoration: none;
    color: black;
  }
  .img-wrapper {
    height: 100%;
    max-width: 50%;
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .product-image {
    width: 100%;
    object-fit: cover;
    object-position: center;
    /* border-radius: 0.5rem; */
    transition: transform 0.5s ease;
  }
  a:hover, a:focus {
    .product-image {
      transform: scale(1.2);
    }
  }
  h3 {
    font-size: clamp(1em, -0.5em + 8vw, 3em);
  }
  p {
    opacity: 0.6;
  }
</style>