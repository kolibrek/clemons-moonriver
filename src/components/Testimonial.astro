---
import { Image } from "astro:assets";
const { name, image, quote } = Astro.props;
---

<article>
  <Image class="image" src={image} alt={name} height={400} />
  <div>
    <h1>{name}</h1>
    <p>"{quote}"</p>
  </div>
</article>

<style>
  article {
    display: grid;
    align-items: space-between;
    box-shadow: 0 0 8px #0008;
    border-radius: 0.5rem;
    background-color: #ddf;
  }
  .image {
    width: 100%;
    object-fit: cover;
    object-position: top;
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
  }
  article div {
    margin-top: auto;
    padding: 0 1rem 1rem 1rem;
  }
  h1 {
  }
  p {
    font-style: italic;
  }
</style>