<style>
  footer {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    background: #171717;
    background-image: url('../assets/noise.svg');
    color: antiquewhite;
    padding: 2rem;
    margin-top: 2rem;
  }
  @media (max-width: 600px) {
    footer {
      grid-template-columns: 1fr;
      grid-template-areas: "a b" "c c";
    }
    .left { grid-area: a; }
    .center { grid-area: c; }
    .right { grid-area: b; }
  }
  footer div {
    display: grid;
    gap: 1rem;
  }
  .left {
    text-align: left;
  }
  .center {
    text-align: center;
  }
  .right {
    text-align: end;
  }
  a {
    color: cyan;
    text-decoration: none;

    &:hover {
      text-decoration: underline;
    }
  }
</style>